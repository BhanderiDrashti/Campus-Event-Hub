<!DOCTYPE html><html><head><title>Student Registration - Campus Event Hub</title><style>body{font-family:Arial;background:#f4f6f8;margin:0;padding:35px}.box{max-width:550px;margin:auto;background:white;padding:30px;border-radius:12px;box-shadow:0 4px 15px #ccc}h1{text-align:center;color:#2c3e50}label{display:block;margin-top:12px;font-weight:bold}input{width:100%;padding:10px;margin-top:6px;box-sizing:border-box;border:1px solid #ccc;border-radius:6px}button{width:100%;margin-top:20px;padding:12px;border:0;border-radius:6px;background:#007bff;color:white;font-size:16px}.back{text-align:center;display:block;margin-top:15px}</style></head><body><div class="box"><h1>Create Student Account</h1><form action="RegisterServlet" method="post"><label>Name</label><input name="name" required><label>Email</label><input type="email" name="email" required><label>Password</label><input type="password" name="password" required><label>Course</label><input name="course" placeholder="Computer Engineering" required><label>Semester</label><input name="semester" required><label>Phone Number</label><input name="phone" required><label>Department</label><input name="department" required><button>Register</button></form><a class="back" href="login.jsp">Already have an account? Login</a></div></body></html>
